{
  "redirects": [
    {
      "source": "/learn/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(tl|ceb)/:section(path|problems|dashboard|submissions|progress|review|lists|plans|contest|settings|about|visualizer|warm-up|topics)/:path*",
      "destination": "/:section/:path*/",
      "permanent": true
    },
    {
      "source": "/tl/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ceb/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
