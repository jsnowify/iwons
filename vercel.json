{
  "redirects": [
    {
      "source": "/learn",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/learn/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/learn/:path+",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(tl|ceb)/:section(path|problems|dashboard|submissions|progress|review|lists|plans|contest|settings|about|visualizer|warm-up|topics)",
      "destination": "/:section/",
      "permanent": true
    },
    {
      "source": "/:locale(tl|ceb)/:section(path|problems|dashboard|submissions|progress|review|lists|plans|contest|settings|about|visualizer|warm-up|topics)/",
      "destination": "/:section/",
      "permanent": true
    },
    {
      "source": "/:locale(tl|ceb)/:section(path|problems|dashboard|submissions|progress|review|lists|plans|contest|settings|about|visualizer|warm-up|topics)/:path+",
      "destination": "/:section/:path+/",
      "permanent": true
    },
    {
      "source": "/:locale(tl|ceb)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(tl|ceb)/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(tl|ceb)/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/og/:slug/",
      "destination": "/og/:slug.png",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/og/:file([a-z0-9-]+\\.[a-f0-9]{16}\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/:slug([a-z0-9-]+).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/runners/js/:file(chunk-[A-Z0-9]+\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/runners/js/worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
