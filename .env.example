NEXT_PUBLIC_SITE_URL=https://iwons.vercel.app

# Server-side only. Never prefix service credentials with NEXT_PUBLIC_.
MONGODB_URI=
MONGODB_DB=iwons
AUTH_SECRET=
# At least 32 random bytes, base64 or hex encoded; required at startup.
# Canonical account origin; use your HTTPS domain in production.
AUTH_URL=http://localhost:3001
JUDGE0_URL=
# Free hosted profile (needs your own free API key; no paid plan required):
# JUDGE0_PROVIDER=onlinecompiler
# JUDGE0_URL=https://api.onlinecompiler.io/api/judge0
# JUDGE0_AUTH_TOKEN=your-free-api-key
JUDGE0_PROVIDER=ce
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=

# Vercel supplies its own trusted IP header. On other hosts, set this only when
# your reverse proxy overwrites the header and strips client-supplied copies.
TRUSTED_IP_HEADER=
# Legacy provider variables are not used by username/password sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Reserved: legacy Solution wrappers are not implemented.
JUDGE0_JAVA_WRAPPERS=false
POINT_WEIGHTS='{"easy":1,"medium":3,"hard":5}'
