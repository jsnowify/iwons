        "title": "Complete a welcome slip",
        "statement": "Complete the fixed greeting so the program prints Welcome, followed by one space and the input line. Preserve the provided input-reading setup and the name identifier. An input line may contain spaces or be empty.",
        "hints": [
          "Separate the fixed greeting from the name received on the input line.",
          "Keep name outside the quoted greeting, so its stored text becomes part of the output.",
          "Print the fixed text Welcome, with a space after the comma, joined to name."
        ]
      },
      "fil": null,
      "ceb": null
    },
