    "shared": {
      "translations": {
        "en": {
          "title": "Repair a desk label (tool demo)",
          "statement": "The label printer reads one line and prints Desk: followed by one space and that line. Keep capitalization and spaces inside the name. The input always contains a line, which can be empty. The final newline is not part of the name.\n\nThis is a temporary tool check, not a course exercise. Repair the prefix in the program, or arrange its blocks, then use the cases to check the result. Trailing whitespace at the end of an output line is ignored by the program runner.",
          "hints": [
            "Compare the first word of the expected output with the first word in the program.",
            "The name should stay unchanged; the prefix supplies Desk and the colon.",
            "Keep the prefix exactly Desk: followed by one space, then print the name."
          ]
        },
        "fil": null,
        "ceb": null
      },
      "translationStatus": {
        "en": "reviewed",
        "fil": "draft",
        "ceb": "draft"
      }
    },
