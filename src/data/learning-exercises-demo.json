        "stdin": "North\n",
        "expected": "Desk: North"
      },
      {
        "id": "label-1",
        "input": [],
        "stdin": "\n",
        "expected": "Desk: "
      },
      {
        "id": "label-2",
        "input": [],
        "stdin": "Tray 7\n",
        "expected": "Desk: Tray 7"
      }
    ],
    "variants": {
