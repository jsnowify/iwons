{
  "name": "iwons",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "node --experimental-strip-types scripts/seed.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-og.mjs && node scripts/prepare-assets.mjs && npm run contrast && npm run verify:curriculum && npm run audit:readability",
    "postbuild": "node scripts/postbuild.mjs",
    "lint": "eslint src e2e scripts --quiet",
    "seo:check": "node scripts/seo-check.mjs",
    "contrast": "node --experimental-strip-types scripts/check-contrast.ts",
    "pretest": "node scripts/prepare-assets.mjs && npm run contrast",
    "validate:problems": "node --experimental-strip-types scripts/validate-problems.ts",
    "verify:curriculum": "node scripts/verify-curriculum.mjs",
    "og": "node scripts/prepare-og.mjs",
    "audit:readability": "node scripts/audit-problem-readability.mjs",
    "start:static": "node scripts/serve.mjs",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db-migrate.ts",
    "db:auth": "node --conditions=react-server --import tsx scripts/auth-indexes.ts",
    "seed:judge": "node --conditions=react-server --import tsx scripts/seed-judge.ts",
    "judge0:smoke": "node --conditions=react-server --import tsx scripts/judge0-smoke-test.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@next/env": "^16.4.3",
    "@tailwindcss/postcss": "^4.1.0",
    "argon2": "^0.45.1",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "mongodb": "^7.7.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sucrase": "^3.35.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "type": "module"
}
