{
  "name": "iwons",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "node --experimental-strip-types scripts/seed.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/build-og.mjs && node scripts/prepare-assets.mjs && npm run contrast && npm run verify:curriculum",
    "postbuild": "node scripts/build-offline.mjs && node scripts/verify-export.mjs",
    "lint": "eslint src e2e scripts --quiet",
    "contrast": "node --experimental-strip-types scripts/check-contrast.ts",
    "pretest": "node scripts/prepare-assets.mjs && npm run contrast",
    "validate:problems": "node --experimental-strip-types scripts/validate-problems.ts",
    "verify:curriculum": "node scripts/verify-curriculum.mjs",
    "og": "node scripts/build-og.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.1.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sucrase": "^3.35.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "type": "module"
}
